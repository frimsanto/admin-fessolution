// Skema database Super Admin Panel FES Solution
// Database khusus platform (platform_admin) — terpisah dari database aplikasi tenant.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// Status langganan tenant
enum TenantStatus {
  TRIAL
  AKTIF
  SUSPENDED
  EXPIRED
}

/// Sasaran pengumuman massal.
enum BroadcastTarget {
  SEMUA
  PER_APLIKASI
  PER_TENANT
}

/// Status pengumuman massal.
enum BroadcastStatus {
  TERKIRIM
  DRAFT
}

/// Akun login pemilik platform (super admin). Tidak terhubung dengan auth tenant.
model SuperAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  notificationReads NotificationRead[]

  @@map("super_admins")
}

/// Produk SaaS yang dikelola platform (CafeOS, BilliardOS, dst).
model App {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  status    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenants    Tenant[]
  broadcasts BroadcastNotification[]

  @@map("apps")
}

/// Klien (bisnis) yang berlangganan salah satu aplikasi SaaS.
model Tenant {
  id           String       @id @default(uuid()) @db.Uuid
  appId        String       @map("app_id") @db.Uuid
  businessName String       @map("business_name")
  ownerEmail   String       @map("owner_email")
  status       TenantStatus @default(TRIAL)
  joinedDate   DateTime     @default(now()) @map("joined_date")
  expiredDate  DateTime     @map("expired_date")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  app        App                     @relation(fields: [appId], references: [id], onDelete: Cascade)
  payments   Payment[]
  broadcasts BroadcastNotification[]

  @@index([appId])
  @@index([status])
  @@index([joinedDate])
  @@index([expiredDate])
  @@map("tenants")
}

/// Catatan pembayaran langganan tenant (konfirmasi manual oleh super admin).
model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  amount      Decimal  @db.Decimal(14, 2)
  paymentDate DateTime @default(now()) @map("payment_date")
  adminNote   String?  @map("admin_note")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([paymentDate])
  @@map("payments")
}

/// Pengumuman massal ke tenant.
/// `target` menentukan mana dari `appId`/`tenantId` yang terisi: SEMUA tidak
/// mengisi keduanya, PER_APLIKASI mengisi appId, PER_TENANT mengisi tenantId.
/// `recipientCount` dibekukan saat kirim — jumlah penerima saat itu, bukan
/// jumlah tenant hari ini.
model BroadcastNotification {
  id             String          @id @default(uuid()) @db.Uuid
  appId          String?         @map("app_id") @db.Uuid
  tenantId       String?         @map("tenant_id") @db.Uuid
  title          String
  message        String
  target         BroadcastTarget @default(SEMUA)
  recipientCount Int             @default(0) @map("recipient_count")
  status         BroadcastStatus @default(TERKIRIM)
  createdAt      DateTime        @default(now()) @map("created_at")

  app    App?    @relation(fields: [appId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([appId])
  @@index([tenantId])
  @@index([createdAt])
  @@index([target])
  @@index([status])
  @@map("broadcast_notifications")
}

/// Token JWT yang sudah di-logout. Baris yang umurnya melewati masa berlaku
/// token dibuang berkala — token kedaluwarsa sudah ditolak oleh verifikasi JWT.
model TokenBlacklist {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("token_blacklist")
}

/// Tanda "sudah dibaca" untuk notifikasi sistem. Notifikasinya sendiri dihitung
/// dari data tenant & pembayaran (tidak disimpan), jadi yang dicatat di sini
/// hanya id notifikasi hasil generate itu per admin.
model NotificationRead {
  id             String   @id @default(uuid()) @db.Uuid
  notificationId String   @map("notification_id")
  adminId        String   @map("admin_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at")

  admin SuperAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([notificationId, adminId])
  @@index([adminId])
  @@map("notification_reads")
}
