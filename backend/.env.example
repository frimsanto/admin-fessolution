# --- Server ---
NODE_ENV=development
PORT=4002

# --- Database (PostgreSQL 16) ---
# Di VPS PostgreSQL berjalan lokal, jadi host-nya localhost.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/platform_admin?schema=public"
# Opsional — batas koneksi pool. Kosongkan untuk memakai default driver.
# DATABASE_POOL_MAX=10

# --- Auth Super Admin (JWT) ---
JWT_SECRET="ganti-dengan-string-acak-panjang"
JWT_EXPIRES_IN="8h"

# --- CORS ---
# Daftar origin frontend yang diizinkan, dipisah koma.
CORS_ORIGINS="http://localhost:5173,https://admin.fessolution.my.id"
